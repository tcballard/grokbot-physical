# Copy to .env for a laptop, or let scripts/install_pi.sh install this as
# /etc/grokbot-orb.env on the Pi. Process environment wins over the file.

# xAI console: https://console.x.ai
XAI_API_KEY=
XAI_REALTIME_MODEL=grok-voice-latest
XAI_VOICE=eve
XAI_TTS_URL=https://api.x.ai/v1/tts
# Optional full override. Leave empty to use wss://api.x.ai/v1/realtime?model=$XAI_REALTIME_MODEL
XAI_REALTIME_URL=

# Grok Bot webhook routine. The panel shows all three.
# URL looks like https://api2.cursor.sh/automations/webhook/<id>
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_BEARER=
GROKBOT_AUTOMATION_KEY=
WEBHOOK_TIMEOUT_S=20

# This orb's callback server.
ORB_CALLBACK_HOST=0.0.0.0
ORB_CALLBACK_PORT=8765
# Origin Grok Bot can reach. No path. A LAN address will not work from Cursor's cloud.
# Example after `tailscale funnel`: https://orb.tailnet-name.ts.net
ORB_PUBLIC_BASE=
# Required if the callback is reachable beyond your kitchen.
ORB_SPEAK_TOKEN=

# Wake word. Missing file falls back to the locally installed hey_jarvis model.
# Fetch shared ONNX assets once with scripts/fetch_wake_models.sh.
WAKE_ASSETS_DIR=models
WAKE_MODEL_PATH=models/hey_grok_bot.onnx
WAKE_FALLBACK=hey_jarvis
WAKE_THRESHOLD=0.5
WAKE_COOLDOWN_S=2.0

# ALSA. Leave the devices empty for the default card. AUDIO_RATE=0 uses 16000 Hz; set 48000 if required by the card.
# ReSpeaker after seeed-voicecard: plughw:CARD=seeed2micvoicec,DEV=0
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_RATE=0
BARGE_IN=true
SESSION_IDLE_S=20

# 16-LED NeoPixel on GPIO 12 (PWM0). GPIO 13 needs HALO_CHANNEL=1.
# Do not use GPIO 18; the ReSpeaker I2S clock is there.
HALO_PIN=12
HALO_CHANNEL=0
HALO_COUNT=16
HALO_BRIGHTNESS=0.35
# auto | log | ws281x. Dry-run forces log unless you set ws281x.
HALO_BACKEND=auto

# TTS when /speak arrives and no Realtime session is open: auto | espeak | none
TTS_FALLBACK=auto

# Laptop / headless bring-up. The CLI flags override these.
DRY_RUN=0
SIMULATE_WAKE=0
SIMULATE_TEXT=
SIMULATE_BOT=bob

LOG_LEVEL=INFO
